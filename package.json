{
  "name": "graphsphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @graphsphere/shared && npm run build -w @graphsphere/api && npm run build -w @graphsphere/worker && npm run build -w @graphsphere/web",
    "dev": "concurrently -n shared,api,worker,web -c cyan,green,magenta,blue \"npm run dev -w @graphsphere/shared\" \"npm run dev -w @graphsphere/api\" \"npm run dev -w @graphsphere/worker\" \"npm run dev -w @graphsphere/web\"",
    "dev:api": "npm run dev -w @graphsphere/api",
    "dev:web": "npm run dev -w @graphsphere/web",
    "dev:worker": "npm run dev -w @graphsphere/worker",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @graphsphere/shared && npm run typecheck -w @graphsphere/api && npm run typecheck -w @graphsphere/worker && npm run typecheck -w @graphsphere/web",
    "seed": "npm run seed -w @graphsphere/api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "fastify": "^5.4.0",
    "ioredis": "^5.7.0",
    "jose": "^6.0.12",
    "lucide-react": "^0.539.0",
    "neo4j-driver": "^5.28.1",
    "pino": "^9.8.0",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "jsdom": "^24.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.13.0",
    "npm": ">=10.0.0"
  }
}
