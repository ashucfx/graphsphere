NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:4000

JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=graphsphere-local
TOKEN_TTL_SECONDS=3600

ADMIN_EMAIL=admin@graphsphere.local
ADMIN_PASSWORD=ChangeMeLocal123!

DATABASE_URL=postgresql://graphsphere:graphsphere@localhost:5432/graphsphere
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphsphere-local
OPENSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=graphsphere-documents
OBJECT_STORAGE_ACCESS_KEY=graphsphere
OBJECT_STORAGE_SECRET_KEY=graphsphere-local
OBJECT_STORAGE_FORCE_PATH_STYLE=true

CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
